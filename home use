];

// ============================================================
// SECURITY / COOKIE
// ============================================================

function sign(value) {
  return crypto
    .createHmac("sha256", SESSION_SECRET)
    .update(value)
    .digest("hex");
}

function createAuthCookie(username) {
  const payload = Buffer.from(
    JSON.stringify({
      username,
      expires: Date.now() + 1000 * 60 * 60 * 24 * 30,
    })
  ).toString("base64url");

  return `${payload}.${sign(payload)}`;
}

function readCookie(req) {
  const header = req.headers.cookie || "";

  const cookies = {};

  header.split(";").forEach((part) => {
    const index = part.indexOf("=");

    if (index === -1) return;

    const key = part.slice(0, index).trim();
    const value = part.slice(index + 1).trim();

    cookies[key] = decodeURIComponent(value);
  });

  return cookies["budget_auth"] || null;
}

function getCurrentUser(req) {
  const cookie = readCookie(req);

  if (!cookie) return null;

  const parts = cookie.split(".");

  if (parts.length !== 2) return null;

  const [payload, signature] = parts;

  const expected = sign(payload);

  if (signature.length !== expected.length) return null;

  if (
    !crypto.timingSafeEqual(
      Buffer.from(signature),
      Buffer.from(expected)
    )
  ) {
    return null;
  }

  try {
    const data = JSON.parse(
      Buffer.from(payload, "base64url").toString()
    );

    if (!data.username) return null;

    if (Date.now() > Number(data.expires)) {
      return null;
    }

    if (!ALLOWED_USERS.includes(data.username)) {
      return null;
    }

    return data.username;
  } catch {
    return null;
  }
}

function requireAuth(req, res, next) {
  const username = getCurrentUser(req);

  if (!username) {
    return res.status(401).json({
      error: "Please log in.",
    });
  }

  req.username = username;

  next();
}

// ============================================================
// FIRESTORE REFERENCES
// ============================================================

function userRef(username) {
  return db.collection("users").doc(username);
}

function itemsRef(username) {
  return userRef(username).collection("items");
}

function budgetsRef(username) {
  return userRef(username).collection("budgets");
}

function spendsRef(username) {
  return userRef(username).collection("spends");
}

// ============================================================
// HELPERS
// ============================================================

function monthKey(value) {
  const text = String(value || "");

  if (!/^\d{4}-\d{2}$/.test(text)) {
    return null;
  }

  const [year, month] = text.split("-").map(Number);

  if (month < 1 || month > 12) {
    return null;
  }

  return text;
}

function nextMonthKey(month) {
  const [year, monthNumber] = month
    .split("-")
    .map(Number);

  const date = new Date(
    year,
    monthNumber - 1,
    1
  );

  date.setMonth(date.getMonth() + 1);

  return (
    date.getFullYear() +
    "-" +
    String(date.getMonth() + 1).padStart(2, "0")
  );
}

function monthLabel(month) {
  const [year, monthNumber] = month
    .split("-")
    .map(Number);

  return new Date(
    year,
    monthNumber - 1,
    1
  ).toLocaleString("en-IN", {
    month: "long",
    year: "numeric",
  });
}

function makeId() {
  return crypto.randomBytes(12).toString("hex");
}

// ============================================================
// INITIALIZE USER
// ============================================================

async function ensureUser(username) {
  const ref = userRef(username);

  const snap = await ref.get();

  if (!snap.exists) {
    await ref.set({
      username,
      createdAt: FieldValue.serverTimestamp(),
    });
  }

  const itemsSnapshot = await itemsRef(username)
    .limit(1)
    .get();

  if (itemsSnapshot.empty) {
    const batch = db.batch();

    for (const name of DEFAULT_ITEMS) {
      const itemRef = itemsRef(username).doc(makeId());

      batch.set(itemRef, {
        name,
        isDefault: true,
        createdAt: FieldValue.serverTimestamp(),
      });
    }

    await batch.commit();
  }
}

async function ensureAllUsers() {
  for (const username of ALLOWED_USERS) {
    await ensureUser(username);
  }
}

// ============================================================
// BUDGET
// ============================================================

async function getBudget(username, month) {
  const snap = await budgetsRef(username)
    .doc(month)
    .get();

  if (!snap.exists) {
    return {
      amount: DEFAULT_BUDGET,
      saved: false,
    };
  }

  return {
    amount: Number(snap.data().amount || 0),
    saved: true,
  };
}

// ============================================================
// SPEND TOTAL
// ============================================================

async function getSpent(username, month) {
  const snapshot = await spendsRef(username)
    .where("month", "==", month)
    .get();

  let total = 0;

  snapshot.forEach((doc) => {
    total += Number(doc.data().amount || 0);
  });

  return total;
}

// ============================================================
// MONTH SUMMARY
// ============================================================

async function getMonthSummary(username, month) {
  const budgetData = await getBudget(
    username,
    month
  );

  const spent = await getSpent(
    username,
    month
  );

  return {
    month,
    label: monthLabel(month),
    budget: budgetData.amount,
    spent,
    leftover: budgetData.amount - spent,
    budgetSaved: budgetData.saved,
  };
}

