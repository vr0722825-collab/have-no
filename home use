app.post("/api/login", async (req, res) => {
  try {
    const username = String(
      req.body.username || ""
    )
      .trim()
      .toLowerCase();

    const password = String(
      req.body.password || ""
    );

    if (!ALLOWED_USERS.includes(username)) {
      return res.status(400).json({
        error: "Wrong username or password.",
      });
    }

    if (password !== SHARED_PASSWORD) {
      return res.status(400).json({
        error: "Wrong username or password.",
      });
    }

    await ensureUser(username);

    const cookie = createAuthCookie(username);

    res.setHeader(
      "Set-Cookie",
      [
        `budget_auth=${encodeURIComponent(cookie)}`,
        "Max-Age=2592000",
        "Path=/",
        "HttpOnly",
        "Secure",
        "SameSite=Lax",
      ].join("; ")
    );

    res.json({
      username,
    });
  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "Login failed.",
    });
  }
});

