// ============================================================
// MONTH DATA
// ============================================================

app.get(
  "/api/month",
  requireAuth,
  async (req, res) => {
    try {
      const month = monthKey(
        req.query.month
      );

      if (!month) {
        return res.status(400).json({
          error: "Choose a valid month.",
        });
      }

      const username = req.username;

      const nextMonth = nextMonthKey(month);

      const current = await getMonthSummary(
        username,
        month
      );

      const next = await getMonthSummary(
        username,
        nextMonth
      );

      const itemsSnapshot = await itemsRef(
        username
      )
        .orderBy("name")
        .get();

      const items = [];

      itemsSnapshot.forEach((doc) => {
        const data = doc.data();

        items.push({
          id: doc.id,
          name: data.name,
          is_default: Boolean(
            data.isDefault
          ),
          spent: 0,
          nextSpent: 0,
          spends: [],
        });
      });

      const itemMap = new Map();

      for (const item of items) {
        itemMap.set(item.id, item);
      }

      const spendsSnapshot = await spendsRef(
        username
      )
        .where("month", "==", month)
        .get();

      spendsSnapshot.forEach((doc) => {
        const data = doc.data();

        const item = itemMap.get(
          data.itemId
        );

        if (!item) return;

        const amount = Number(
          data.amount || 0
        );

        item.spent += amount;

        item.spends.push({
          id: doc.id,
          amount,
          note: data.note || "",
          spentOn: data.spentOn,
        });
      });

      const nextSpendsSnapshot =
        await spendsRef(username)
          .where("month", "==", nextMonth)
          .get();

      nextSpendsSnapshot.forEach((doc) => {
        const data = doc.data();

        const item = itemMap.get(
          data.itemId
        );

        if (!item) return;

        item.nextSpent += Number(
          data.amount || 0
        );
      });

      for (const item of items) {
        item.spends.sort((a, b) => {
          if (a.spentOn === b.spentOn) {
            return b.id.localeCompare(a.id);
          }

          return b.spentOn.localeCompare(
            a.spentOn
          );
        });
      }

      res.json({
        ...current,
        next,
        items,
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Could not load month.",
      });
    }
  }
);

// ============================================================
// UPDATE BUDGET
// ============================================================

app.put(
  "/api/budget",
  requireAuth,
  async (req, res) => {
    try {
      const month = monthKey(
        req.body.month
      );

      const amount = Number(
        req.body.amount
      );

      if (!month) {
        return res.status(400).json({
          error: "Choose a valid month.",
        });
      }

      if (
        !Number.isFinite(amount) ||
        amount < 0
      ) {
        return res.status(400).json({
          error:
            "Enter a valid budget amount.",
        });
      }

      await budgetsRef(req.username)
        .doc(month)
        .set({
          amount,
          updatedAt:
            FieldValue.serverTimestamp(),
        });

      res.json({
        month,
        amount,
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Could not save budget.",
      });
    }
  }
);

// ============================================================
// ADD ITEM
// ============================================================

app.post(
  "/api/items",
  requireAuth,
  async (req, res) => {
    try {
      const name = String(
        req.body.name || ""
      ).trim();

      if (!name) {
        return res.status(400).json({
          error:
            "Enter a name for the new thing.",
        });
      }

      const snapshot = await itemsRef(
        req.username
      ).get();

      const exists = snapshot.docs.some(
        (doc) =>
          String(doc.data().name)
            .toLowerCase() ===
          name.toLowerCase()
      );

      if (exists) {
        return res.status(400).json({
          error:
            "That thing is already on the list.",
        });
      }

      const id = makeId();

      await itemsRef(req.username)
        .doc(id)
        .set({
          name,
          isDefault: false,
          createdAt:
            FieldValue.serverTimestamp(),
        });

      res.json({
        id,
        name,
        is_default: 0,
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Could not add item.",
      });
    }
  }
);

// ============================================================
// EDIT ITEM
// ============================================================

app.patch(
  "/api/items/:id",
  requireAuth,
  async (req, res) => {
    try {
      const id = req.params.id;

      const name = String(
        req.body.name || ""
      ).trim();

      if (!name) {
        return res.status(400).json({
          error: "Enter a name.",
        });
      }

      const itemRef = itemsRef(
        req.username
      ).doc(id);

      const itemSnap =
        await itemRef.get();

      if (!itemSnap.exists) {
        return res.status(404).json({
          error: "Item not found.",
        });
      }

      const snapshot = await itemsRef(
        req.username
      ).get();

      const clash = snapshot.docs.find(
        (doc) =>
          doc.id !== id &&
          String(doc.data().name)
            .toLowerCase() ===
            name.toLowerCase()
      );

      if (clash) {
        return res.status(400).json({
          error:
            "That thing is already on the list.",
        });
      }

      await itemRef.update({
        name,
        updatedAt:
          FieldValue.serverTimestamp(),
      });

      const oldData = itemSnap.data();

      res.json({
        id,
        name,
        is_default: oldData.isDefault
          ? 1
          : 0,
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Could not edit item.",
      });
    }
  }
);

// ============================================================
// DELETE ITEM
// ============================================================

app.delete(
  "/api/items/:id",
  requireAuth,
  async (req, res) => {
    try {
      const id = req.params.id;

      const itemRef = itemsRef(
        req.username
      ).doc(id);

      const itemSnap =
        await itemRef.get();

      if (!itemSnap.exists) {
        return res.status(404).json({
          error: "Item not found.",
        });
      }

      const spendsSnapshot =
        await spendsRef(req.username)
          .where("itemId", "==", id)
          .get();

      const batch = db.batch();

      spendsSnapshot.forEach((doc) => {
        batch.delete(doc.ref);
      });

      batch.delete(itemRef);

      await batch.commit();

      res.json({
        ok: true,
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Could not delete item.",
      });
    }
  }
);

