}

.spend-note {
  color: #687386;
}

.spend-amount {
  font-weight: 800;
}

.delete-spend {
  border: 0;

  background: transparent;

  color: #d32f2f;

  font-size: 12px;
}

/* ADD */

.add-box {
  display: flex;

  gap: 10px;

  margin-top: 15px;
}

.add-box input {
  flex: 1;
}

/* NEXT */

.next-card {
  margin-top: 25px;

  background: #fff;

  border-radius: 18px;

  padding: 20px;

  box-shadow:
    0 8px 30px
    rgba(0,0,0,.06);
}

.next-card h3 {
  margin-top: 0;
}

.next-grid {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 10px;
}

.next-item {
  background: #f7f8fb;

  padding: 12px;

  border-radius: 12px;
}

/* TOAST */

.toast {
  position: fixed;

  bottom: 20px;

  left: 50%;

  transform:
    translateX(-50%);

  background: #182230;

  color: white;

  padding: 12px 18px;

  border-radius: 12px;

  display: none;

  z-index: 100;
}

/* MOBILE */

@media (max-width: 700px) {

  .stats {
    grid-template-columns: 1fr;
  }

  .items {
    grid-template-columns: 1fr;
  }

  .next-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    padding: 12px;
  }

  .user-name {
    display: none;
  }

  .month-title {
    width: 100%;

    flex-basis: 100%;

    font-size: 21px;
  }

  .month-bar input {
    width: 100%;
  }

  .budget-box input {
    width: 100%;
  }

  .budget-box {
    align-items: stretch;
  }

  .small-btn {
    width: 100%;
  }

  .add-box {
    flex-direction: column;
  }

}

</style>

</head>

<body>

<!-- LOGIN -->

<div id="loginPage" class="login-page">

  <div class="login-card">

    <div class="logo">
      💰
    </div>

    <h1>Home Budget</h1>

    <p>
      Monthly budget manager
    </p>

    <form id="loginForm">

      <div class="form-group">

        <label>
          Username
        </label>

        <input
          id="username"
          autocomplete="username"
          placeholder="vicky"
          required
        >

      </div>

      <div class="form-group">

        <label>
          Password
        </label>

        <input
          id="password"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
          required
        >

      </div>

      <button
        class="primary"
        type="submit"
      >
        Login
      </button>

      <div
        id="loginError"
        class="error"
      ></div>

    </form>

  </div>

</div>

<!-- APP -->

<div
  id="app"
  class="app hidden"
>

  <div class="topbar">

    <div class="brand">
      💰 Home Budget
    </div>

    <div class="user-area">

      <span
        id="userName"
        class="user-name"
      ></span>

      <button
        id="logoutBtn"
        class="logout"
      >
        Logout
      </button>

    </div>

  </div>

  <main class="container">

    <div class="month-bar">

      <div
        id="monthTitle"
        class="month-title"
      >
        Month
      </div>

      <input
        id="monthPicker"
        type="month"
      >

    </div>

    <div class="stats">

      <div class="card">

        <div class="stat-label">
          Monthly Budget
        </div>

        <div
          id="budgetValue"
          class="stat-value"
        >
          ₹0
        </div>

      </div>

      <div class="card">

        <div class="stat-label">
          Total Spent
        </div>

        <div
          id="spentValue"
          class="stat-value"
        >
          ₹0
        </div>

      </div>

      <div class="card">

        <div class="stat-label">
          Remaining
        </div>

        <div
          id="leftoverValue"
          class="stat-value leftover"
        >
          ₹0
        </div>

      </div>

    </div>

    <div class="card">

      <div class="section-title">
        Monthly Budget
      </div>

      <div class="budget-box">

        <div class="form-group">

          <label>
            Budget amount (₹)
          </label>

          <input
            id="budgetInput"
            type="number"
            min="0"
            step="1"
          >

        </div>

        <button
          id="saveBudgetBtn"
          class="small-btn"
        >
          Save Budget
        </button>

      </div>

    </div>

    <div class="section-title">
      Spending Items
    </div>

    <div
      id="items"
      class="items"
    ></div>

    <div class="card">

      <div class="section-title">
        Add New Item
      </div>

      <div class="add-box">

        <input
          id="newItem"
          placeholder="Example: Internet bill"
        >

        <button
          id="addItemBtn"
          class="small-btn"
        >
          Add Item
        </button>

      </div>

    </div>

    <div class="next-card">

      <h3>
        Next Month Preview
      </h3>

      <p id="nextMonthLabel">
        Next month
      </p>

      <div
        id="nextGrid"
        class="next-grid"
      ></div>

    </div>

  </main>

</div>

<div
  id="toast"
  class="toast"
></div>

<script>

let currentMonth = "";
let currentData = null;

const loginPage =
  document.getElementById("loginPage");

const app =
  document.getElementById("app");

const loginForm =
  document.getElementById("loginForm");

const loginError =
  document.getElementById("loginError");

const usernameInput =
  document.getElementById("username");

const passwordInput =
  document.getElementById("password");

const userName =
  document.getElementById("userName");

const monthPicker =
  document.getElementById("monthPicker");

const monthTitle =
  document.getElementById("monthTitle");

const itemsContainer =
  document.getElementById("items");

const budgetValue =
  document.getElementById("budgetValue");

const spentValue =
  document.getElementById("spentValue");

const leftoverValue =
  document.getElementById("leftoverValue");

const budgetInput =
  document.getElementById("budgetInput");

const nextGrid =
  document.getElementById("nextGrid");

const nextMonthLabel =
  document.getElementById("nextMonthLabel");

function money(value) {

  return new Intl.NumberFormat(
    "en-IN",
    {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 0
    }
  ).format(Number(value || 0));

}

function showToast(message) {

  const toast =
    document.getElementById("toast");

  toast.textContent = message;

  toast.style.display = "block";

  setTimeout(() => {

    toast.style.display = "none";

  }, 2200);

}

function todayMonth() {

  const d = new Date();

  return (
    d.getFullYear() +
    "-" +
    String(
      d.getMonth() + 1
    ).padStart(2, "0")
  );

}

function todayDate() {

  const d = new Date();

  return (
    d.getFullYear() +
    "-" +
    String(
      d.getMonth() + 1
    ).padStart(2, "0") +
    "-" +
    String(
      d.getDate()
    ).padStart(2, "0")
  );

}

async function api(
  url,
  options = {}
) {

  const response =
    await fetch(url, {
      ...options,

      headers: {
        "Content-Type":
          "application/json",

        ...(options.headers || {})
      }
    });

  let data = {};

  try {
    data = await response.json();
  } catch {}

  if (!response.ok) {

    throw new Error(
      data.error ||
      "Something went wrong."
    );

  }

  return data;

}

async function checkLogin() {

  try {

    const me =
      await api("/api/me");

    userName.textContent =
      me.username;

    loginPage.classList.add(
      "hidden"
    );

    app.classList.remove(
      "hidden"
    );

    currentMonth =
      todayMonth();

    monthPicker.value =
      currentMonth;

    await loadMonth();

  } catch {

    loginPage.classList.remove(
      "hidden"
    );

    app.classList.add(
      "hidden"
    );

  }

}

loginForm.addEventListener(
  "submit",
  async (event) => {

    event.preventDefault();

    loginError.textContent =
      "";

    try {

      const data =
        await api(
          "/api/login",
          {
            method: "POST",

            body: JSON.stringify({
              username:
                usernameInput.value,

              password:
                passwordInput.value
            })
          }
        );

      userName.textContent =
        data.username;

      loginPage.classList.add(
        "hidden"
      );

      app.classList.remove(
        "hidden"
      );

      currentMonth =
        todayMonth();

      monthPicker.value =
        currentMonth;

      passwordInput.value =
        "";

      await loadMonth();

    } catch (error) {

      loginError.textContent =
        error.message;

    }

  }
);

document
  .getElementById("logoutBtn")
  .addEventListener(
    "click",
    async () => {

      await api(
        "/api/logout",
        {
          method: "POST"
        }
      );

      app.classList.add(
        "hidden"
      );

      loginPage.classList.remove(
        "hidden"
      );

      usernameInput.value =
        "";

      passwordInput.value =
        "";

    }
  );

monthPicker.addEventListener(
  "change",
  async () => {

    if (!monthPicker.value) {
      return;
    }

    currentMonth =
      monthPicker.value;

    await loadMonth();

  }
);

async function loadMonth() {

  try {

    const data =
      await api(
        "/api/month?month=" +
        encodeURIComponent(
          currentMonth
        )
      );

    currentData =
      data;

    render(data);

  } catch (error) {

    showToast(
      error.message
    );

  }

}

function render(data) {

  monthTitle.textContent =
    data.label;

  budgetValue.textContent =
    money(data.budget);

  spentValue.textContent =
    money(data.spent);

  leftoverValue.textContent =
    money(data.leftover);

  leftoverValue.style.color =
    data.leftover < 0
      ? "#d32f2f"
      : "#16833b";

  budgetInput.value =
    data.budget;

  renderItems(
    data.items,
    data.budget
  );

  nextMonthLabel.textContent =
    data.next.label +
    " • Budget: " +
    money(data.next.budget);

  nextGrid.innerHTML =
    "";

  data.items.forEach(
    item => {

      const div =
        document.createElement(
          "div"
        );

      div.className =
        "next-item";

      div.innerHTML =
        `<strong>${escapeHtml(item.name)}</strong><br><span>Planned spent: ${money(item.nextSpent)}</span>`;

      nextGrid.appendChild(
        div
      );

    }
  );

}

function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

}

function renderItems(
  items,
  budget
) {

  itemsContainer.innerHTML =
    "";

  items.forEach(
    item => {

      const card =
        document.createElement("div");

      card.className =
        "item-card";

      const percent =
        budget > 0
          ? Math.min(
              100,
              (item.spent /
                budget) *
                100
            )
          : 0;

      const spends =
        item.spends || [];

      card.innerHTML = `
        <div class="item-header">
          <div>
            <div class="item-name">
              ${escapeHtml(
                item.name
              )}
            </div>
            <div class="item-spent">
              Spent:
              ${money(
                item.spent
              )}
            </div>
          </div>
          <div class="item-actions">
            <button
              class="icon-btn edit-item"
              title="Edit"
            >
              ✏️
            </button>
            <button
              class="icon-btn delete-item"
              title="Delete"
            >
              🗑️
            </button>

          </div>

        </div>

        <div class="progress">

          <div
            class="progress-bar"
            style="width:${percent}%"
          ></div>

        </div>

        <button
          class="small-btn add-spend"
          style="width:100%"
        >
          + Add Spending
        </button>

        <div class="spend-list"></div>

      `;

      const spendList =
        card.querySelector(
          ".spend-list"
        );

      spends.forEach(
        spend => {

          const row =
            document.createElement(
              "div"
            );

          row.className =
            "spend-row";

          row.innerHTML = `

            <div>

              <strong>
                ${money(
                  spend.amount
                )}
              </strong>

              <br>

              <span class="spend-note">
                ${escapeHtml(
                  spend.note ||
                  "No note"
                )}
                &bull;
                ${escapeHtml(
                  spend.spentOn
                )}
              </span>

            </div>

            <button
              class="delete-spend"
            >
              Delete
            </button>

          `;

          row
            .querySelector(
              ".delete-spend"
            )
            .addEventListener(
              "click",
              () =>
                deleteSpend(
                  spend.id
                )
            );

          spendList.appendChild(
            row
          );

        }
      );

      card
        .querySelector(
          ".edit-item"
        )
        .addEventListener(
          "click",
          () =>
            editItem(item)
        );

      card
        .querySelector(
          ".delete-item"
        )
        .addEventListener(
          "click",
          () =>
            removeItem(item)
        );

      card
        .querySelector(
          ".add-spend"
        )
        .addEventListener(
          "click",
          () =>
            addSpend(item)
        );

      itemsContainer.appendChild(
        card
      );

    }
  );

}

async function editItem(item) {

  const name =
    prompt(
      "Enter new item name:",
      item.name
    );

  if (
    name === null ||
    !name.trim()
  ) {
    return;
  }

  try {

    await api(
      "/api/items/" +
      item.id,
      {
        method: "PATCH",

        body: JSON.stringify({
          name: name.trim()
        })
      }
    );

    showToast(
      "Item updated."
    );

    await loadMonth();

  } catch (error) {

    showToast(
      error.message
    );

  }

}

async function removeItem(item) {

  const ok =
    confirm(
      "Delete '" +
      item.name +
      "' and all its spending records?"
    );

  if (!ok) return;

  try {

    await api(
      "/api/items/" +
      item.id,
      {
        method: "DELETE"
      }
    );

    showToast(
      "Item deleted."
    );

    await loadMonth();

  } catch (error) {

    showToast(
      error.message
    );

  }

}

async function addSpend(item) {

  const amountText =
    prompt(
      "Enter spending amount (₹):"
    );

  if (
    amountText === null
  ) {
    return;
  }

  const amount =
    Number(amountText);

  if (
    !Number.isFinite(amount) ||
    amount <= 0
  ) {

    showToast(
      "Enter a valid amount."
    );

    return;

  }

  const note =
    prompt(
      "Enter note (optional):"
    ) || "";

  const spentOn =
    prompt(
      "Enter date YYYY-MM-DD:",
      todayDate()
    );

  if (!spentOn) {
    return;
  }

  try {

    await api(
      "/api/spends",
      {
        method: "POST",

        body: JSON.stringify({
          month:
            currentMonth,

          itemId:
            item.id,

          amount,

          note,

          spentOn
        })
      }
    );

    showToast(
      "Spending added."
    );

    await loadMonth();

  } catch (error) {

    showToast(
      error.message
    );

  }

}

async function deleteSpend(id) {

  const ok =
    confirm(
      "Delete this spending record?"
    );

  if (!ok) return;

  try {

    await api(
      "/api/spends/" +
      id,
      {
        method: "DELETE"
      }
    );

    showToast(
      "Spending deleted."
    );

    await loadMonth();

  } catch (error) {

    showToast(
      error.message
    );

  }

}

document
  .getElementById("saveBudgetBtn")
  .addEventListener(
    "click",
    async () => {

      const amount =
        Number(
          budgetInput.value
        );

      if (
        !Number.isFinite(amount) ||
        amount < 0
      ) {

        showToast(
          "Enter a valid budget."
        );

        return;

      }

      try {

        await api(
          "/api/budget",
          {
            method: "PUT",

            body: JSON.stringify({
              month:
                currentMonth,

              amount
            })
          }
        );

        showToast(
          "Budget saved."
        );

        await loadMonth();

      } catch (error) {

        showToast(
          error.message
        );

      }

    }
  );

document
  .getElementById("addItemBtn")
  .addEventListener(
    "click",
    async () => {

      const input =
        document.getElementById(
          "newItem"
        );

      const name =
        input.value.trim();

      if (!name) {

        showToast(
          "Enter an item name."
        );

        return;

      }

      try {

        await api(
          "/api/items",
          {
            method: "POST",

            body: JSON.stringify({
              name
            })
          }
        );

        input.value =
          "";

        showToast(
          "Item added."
        );

        await loadMonth();

      } catch (error) {

        showToast(
          error.message
        );

      }

    }
  );

checkLogin();

</script>

</body>
</html>
`;

// ============================================================
// SERVE WEBSITE
// ============================================================

app.get(
  "/",
  async (req, res) => {

    res.setHeader(
      "Cache-Control",
      "no-store"
    );

    res.type("html").send(HTML);

  }
);

// ============================================================
// EXPORT FIREBASE FUNCTION
// ============================================================

exports.app = onRequest(
  {
    region: "us-central1",
    memory: "256MiB",
    timeoutSeconds: 60,
    maxInstances: 10,
  },
  app
);