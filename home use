// ADD SPEND
// ============================================================

app.post(
  "/api/spends",
  requireAuth,
  async (req, res) => {
    try {
      const month = monthKey(
        req.body.month
      );

      const itemId = String(
        req.body.itemId || ""
      );

      const amount = Number(
        req.body.amount
      );

      const note = String(
        req.body.note || ""
      ).trim();

      const spentOn = String(
        req.body.spentOn || ""
      ).slice(0, 10);

      if (!month) {
        return res.status(400).json({
          error: "Choose a valid month.",
        });
      }

      if (
        !Number.isFinite(amount) ||
        amount <= 0
      ) {
        return res.status(400).json({
          error:
            "Enter a spend amount greater than 0.",
        });
      }

      if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
          spentOn
        )
      ) {
        return res.status(400).json({
          error: "Choose a date.",
        });
      }

      const itemSnap =
        await itemsRef(req.username)
          .doc(itemId)
          .get();

      if (!itemSnap.exists) {
        return res.status(404).json({
          error: "Item not found.",
        });
      }

      const id = makeId();

      await spendsRef(req.username)
        .doc(id)
        .set({
          itemId,
          month,
          amount,
          note,
          spentOn,
          createdAt:
            FieldValue.serverTimestamp(),
        });

      res.json({
        id,
        itemId,
        amount,
        note,
        spentOn,
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Could not save spend.",
      });
    }
  }
);

